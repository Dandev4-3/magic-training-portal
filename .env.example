# ============================================================
# Magic Training Portal — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ============================================================

# --- NextAuth -----------------------------------------------
# A long random string (run: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-here

# The URL your portal runs at (no trailing slash)
NEXTAUTH_URL=https://portal.magic-training.co.uk

# --- Email (Nodemailer) -------------------------------------
# SMTP server for sending invoice emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM="Magic Training <invoices@magic-training.co.uk>"

# Common providers:
#
# Gmail (requires App Password — not your regular password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=xxxx-xxxx-xxxx-xxxx   (16-char app password)
#
# Outlook / Microsoft 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#
# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxx
#
# GoDaddy Workspace Email:
#   SMTP_HOST=smtpout.secureserver.net
#   SMTP_PORT=465  (SSL) or 587 (TLS)

# --- Stripe (optional — for online payments) ----------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
